# Beacon Environment Configuration
# Copy to .env.local and fill in values

# =============================================================================
# AI Provider Configuration (BYOK - Bring Your Own Key)
# =============================================================================
# Beacon uses Omni CLI's agent core for AI. Configure your provider keys below.
#
# Option 1: Direct Provider Keys (recommended)
#   - ANTHROPIC_API_KEY for Claude models (recommended)
#   - OPENAI_API_KEY for GPT models + Whisper STT/TTS (semantic memory runs
#     through the Synapse gateway at SYNAPSE_URL, not on this key)
#
# Option 2: OpenRouter (one key for 500+ models)
#   - OPENROUTER_API_KEY for unified access
#   - Get your key at https://openrouter.ai/keys
#
# Option 3 (cloud mode): Omni credits
#   - No API keys needed. Each signed-in user gets a product-scoped managed key
#     (appId "beacon", billed to the user) provisioned via SYNAPSE_API_URL. The
#     Synapse gateway checks and deducts credits from the user's pooled Omni
#     balance (shared across Omni products). See "Cloud mode" below
#
# Coming Soon:
#   - Lattice: Smart routing with MCP support and cost optimization

# Anthropic (recommended for agent)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (for Whisper STT, TTS, and as fallback LLM)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (unified access to 500+ models)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# LLM provider preference: "anthropic", "openai", or "openrouter"
# If unset, uses Anthropic if available, falls back to OpenAI
# BEACON_LLM_PROVIDER=

# =============================================================================
# Optional: Voice Services
# =============================================================================

# ElevenLabs (alternative TTS with more voice options)
# ELEVENLABS_API_KEY=

# Deepgram (alternative STT, faster than Whisper)
# DEEPGRAM_API_KEY=

# =============================================================================
# Optional: Messaging Channels
# =============================================================================

# Discord
# DISCORD_TOKEN=

# Slack
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=

# Telegram
# TELEGRAM_BOT_TOKEN=

# =============================================================================
# Service Configuration
# =============================================================================

# API server port (default: 18790)
# BEACON_API_PORT=18790

# API key for admin endpoints (optional, recommended for production)
# BEACON_API_KEY=

# Static files directory for web UI
# BEACON_STATIC_DIR=

# Log level (default: info)
# RUST_LOG=info

# Persona (default: orin)
# BEACON_PERSONA=orin

# =============================================================================
# =============================================================================
# Synapse Integration (BYOK key resolution + LLM routing)
# =============================================================================

# Synapse API URL (per-user BYOK key resolution and, in cloud mode,
# product-scoped managed key provisioning)
SYNAPSE_API_URL=http://localhost:4000

# Shared secret for authenticating to Synapse internal endpoints
# Must match GATEWAY_SECRET in synapse-api
SYNAPSE_GATEWAY_SECRET=

# =============================================================================
# Cloud mode (multi-tenant, Omni credits)
# =============================================================================

# Require Gatekeeper JWTs and run managed AI on per-user product-scoped keys.
# There is no shared-key fallback: if a key cannot be provisioned, AI is
# reported as temporarily unavailable
# BEACON_CLOUD_MODE=true

# Default model for paid tiers (free tier always defaults to
# anthropic/claude-haiku-5-5; users can still pick a model explicitly)
# BEACON_LLM_MODEL=anthropic/claude-sonnet-5-5

# Where out-of-credits / upgrade messages link to
# BEACON_BILLING_URL=https://beacon.omni.dev/settings

# Billing (Aether): entitlements (api_access, voice_enabled), the conversations
# meter, and the plan tier. The Aether app id is always "beacon". Credits are
# checked and charged by the Synapse gateway, never by Beacon
# Legacy aliases still read: BILLING_API_URL / AETHER_URL,
# BILLING_API_KEY / AETHER_SERVICE_API_KEY, AETHER_FAIL_MODE, AETHER_CACHE_TTL_SECS
# BILLING_BASE_URL=https://api.billing.omni.dev
# BILLING_SERVICE_API_KEY=
# "open" (default) lets requests through when Aether is unreachable, "closed" rejects them
# BILLING_FAIL_MODE=open
# BILLING_CACHE_TTL_SECS=60

# =============================================================================
# Omni Integration
# =============================================================================

# Manifold registry URL (for skills and personas marketplace)
# MANIFOLD_URL=https://manifold.omni.dev

# Omni CLI agent core (future: will be extracted to agent-core crate)
# Currently embedded via library dependency
# OMNI_CLI_URL=http://localhost:8080
# OMNI_CLI_TOKEN=

# HIDRA (identity and auth)
# HIDRA_URL=https://hidra.omni.dev
# HIDRA_CLIENT_ID=
# HIDRA_CLIENT_SECRET=

# =============================================================================
# Event Streaming (Iggy)
# =============================================================================
# IGGY_HOST=localhost
# IGGY_HTTP_PORT=3000
# IGGY_USERNAME=iggy
# IGGY_PASSWORD=iggy

# =============================================================================
# Vortex Scheduling
# =============================================================================
# VORTEX_URL=http://localhost:4000
# VORTEX_API_KEY=
